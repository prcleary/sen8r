\arguments{
\item{params}{A named list of query parameters, such as
\code{list(review_state = "verified")}. Do not include \code{limit} or \code{b_start};
the getter manages pagination.}

\item{limit}{Positive whole number of records to request per page.
This is a page size, not a limit on the total number returned.}

\item{verbose}{If \code{TRUE}, report download progress.}

\item{profile}{Name of the connection profile saved by \code{\link[=senaite_setup]{senaite_setup()}}.
Defaults to \code{"default"}.}
}
\value{
A list of records, or an empty list for an empty collection.
As with \code{\link[=get_senaite_data]{get_senaite_data()}}, a successful response without a \code{pages}
field returns \code{NULL}. HTTP errors raise an error.
}
\description{
Each wrapper calls \code{\link[=get_senaite_data]{get_senaite_data()}} with a fixed endpoint name.
For example, \code{get_client()} queries the \code{client} endpoint.
The selected profile supplies the instance URL and credentials.
}
\examples{
\dontrun{
clients <- get_client(profile = "lab-lan")

verified <- get_analysisrequest(
  params = list(review_state = "verified"),
  limit = 50,
  profile = "lab-lan"
)
}
}
